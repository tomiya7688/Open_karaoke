<Window
    x:Class="OpenKaraoke.Gui.MainWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:client="clr-namespace:OpenKaraoke.Client;assembly=OpenKaraoke.Client"
    xmlns:local="clr-namespace:OpenKaraoke.Gui"
    x:DataType="client:ShellViewModel"
    Title="Open Karaoke — 開発版"
    Width="1080" Height="740" MinWidth="780" MinHeight="580"
    WindowStartupLocation="CenterScreen">
  <!--
    画面構成: 上部バー(ブランド・接続状態・接続操作) / エラー通知 / タブ(Job・曲と歌詞・設定) / 下部の注意書き。
    見た目の定義は App.axaml のクラスとリソースに置き、ここでは構造だけを書く。
    GUIスモークテストはボタンの文言、TabControl・ProgressBarが各1つ、タブの並び(設定は3番目)、
    設定タブの入力欄が3つであることに依存する。
  -->
  <Grid RowDefinitions="Auto,Auto,*,Auto">

    <!-- 上部バー -->
    <Border Classes="appBar">
      <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16">
        <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
          <Border Classes="logo">
            <TextBlock Text="♪" Foreground="White" AutomationProperties.AccessibilityView="Raw" FontSize="18" FontWeight="Bold"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <TextBlock Classes="appTitle" Text="Open Karaoke" VerticalAlignment="Center" />
          <Border Classes="badge">
            <TextBlock Text="開発版" FontSize="11.5" Foreground="{DynamicResource OkMutedForeground}" />
          </Border>
        </StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
          <Border Classes="statusPill"
                  Classes.connected="{Binding IsConnected}"
                  Classes.busy="{Binding IsTransitioning}">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Ellipse Width="8" Height="8" VerticalAlignment="Center" />
              <TextBlock Text="{Binding ConnectionStatus}" FontSize="13" FontWeight="Medium"
                         VerticalAlignment="Center" MaxWidth="200" TextTrimming="CharacterEllipsis"
                         ToolTip.Tip="{Binding ConnectionStatus}" />
            </StackPanel>
          </Border>
          <Button Classes="accent" Content="Coreに接続"
                  IsEnabled="{Binding CanConnect}" Click="ConnectClick" />
          <Button Classes="danger" Content="切断・Coreを終了"
                  IsEnabled="{Binding CanDisconnect}" Click="DisconnectClick" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- エラー通知: エラーがある間だけ表示し、全文を選択・コピーできるようにする -->
    <Border Grid.Row="1" Classes="infoBar error" Margin="24,16,24,0" IsVisible="{Binding HasError}">
      <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
        <Border Width="22" Height="22" CornerRadius="11" VerticalAlignment="Top"
                Background="{DynamicResource OkDanger}">
          <TextBlock Text="!" FontWeight="Bold" AutomationProperties.AccessibilityView="Raw" Foreground="{DynamicResource OkDangerSubtle}"
                     HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
        <StackPanel Grid.Column="1" Spacing="2">
          <TextBlock Classes="infoTitle" Text="エラーが発生しました" />
          <ScrollViewer MaxHeight="96">
            <SelectableTextBlock Text="{Binding Error}" TextWrapping="Wrap" FontSize="13" />
          </ScrollViewer>
        </StackPanel>
      </Grid>
    </Border>

    <!-- 本文 -->
    <TabControl Grid.Row="2" Margin="24,8,24,0">
      <TabItem Header="解析・Job">
        <ScrollViewer>
          <StackPanel Spacing="16" Margin="0,12,0,20">

            <!-- 接続テストJob -->
            <Border Classes="card">
              <StackPanel Spacing="16">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                  <StackPanel Spacing="4">
                    <TextBlock Classes="cardTitle" Text="接続テストJob" />
                    <TextBlock Classes="caption"
                               Text="Coreとの通信・進捗表示・キャンセルを確かめるためのJobです。楽曲の解析やカラオケ再生は行いません。" />
                  </StackPanel>
                  <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Top">
                    <Button Classes="accent" Content="接続テストJobを開始"
                            IsEnabled="{Binding CanRun}" Click="RunClick" />
                    <Button Classes="danger" Content="キャンセル"
                            IsEnabled="{Binding CanCancel}" Click="CancelClick" />
                  </StackPanel>
                </Grid>
                <Grid ColumnDefinitions="*,Auto">
                  <StackPanel Spacing="2" VerticalAlignment="Bottom">
                    <TextBlock Classes="caption" Text="状態" />
                    <TextBlock Text="{Binding JobStatusLabel}" FontSize="15" FontWeight="SemiBold" />
                  </StackPanel>
                  <TextBlock Grid.Column="1" Classes="metric" Text="{Binding ProgressText}" IsVisible="{Binding HasJob}"
                             VerticalAlignment="Bottom" />
                </Grid>
                <ProgressBar Classes="slim" Minimum="0" Maximum="100" Value="{Binding Progress}"
                             AutomationProperties.Name="Jobの進捗" />
              </StackPanel>
            </Border>

            <!-- 接続情報 -->
            <Border Classes="card">
              <StackPanel Spacing="14">
                <TextBlock Classes="cardTitle" Text="接続情報" />
                <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="24" RowSpacing="10">
                  <TextBlock Classes="caption" Text="接続状態" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="1" Text="{Binding ConnectionStatus}" TextWrapping="Wrap" />
                  <TextBlock Grid.Row="1" Classes="caption" Text="利用可能なモデル" VerticalAlignment="Center" />
                  <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Models}" TextWrapping="Wrap" />
                  <TextBlock Grid.Row="2" Classes="caption" Text="追加モデル" VerticalAlignment="Top" />
                  <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding ModelPackages}" TextWrapping="Wrap" />
                </Grid>
                <Expander Header="技術情報(Job ID・セッションID)">
                  <StackPanel Spacing="10">
                    <TextBlock Classes="fieldLabel" Text="Job ID" />
                    <Border Classes="codeBox">
                      <SelectableTextBlock Classes="mono" Text="{Binding JobId}" />
                    </Border>
                    <TextBlock Classes="fieldLabel" Text="Coreが返したJobの状態" />
                    <Border Classes="codeBox">
                      <SelectableTextBlock Classes="mono" Text="{Binding JobStatus}" />
                    </Border>
                    <TextBlock Classes="fieldLabel" Text="セッションID" />
                    <TextBlock Classes="caption" Text="認証情報ではありません。問題を報告するときの識別に使えます。" />
                    <Border Classes="codeBox">
                      <SelectableTextBlock Classes="mono" Text="{Binding SessionId}" />
                    </Border>
                  </StackPanel>
                </Expander>
              </StackPanel>
            </Border>

            <Border Classes="infoBar">
              <TextBlock Classes="body"
                         Text="取り込み済みの曲の歌詞と音程バーは「曲・歌詞」タブで確認できます。楽曲の解析・伴奏の再生・採点の画面は今後追加します。" />
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="曲・歌詞">
        <Grid ColumnDefinitions="300,*" ColumnSpacing="16" Margin="0,12,0,20">

          <!-- 曲一覧 -->
          <Border Classes="card">
            <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="12">
              <StackPanel Spacing="4">
                <TextBlock Classes="cardTitle" Text="曲一覧" />
                <TextBlock Classes="caption" Text="{Binding SongLibraryStatus}" TextWrapping="Wrap" />
              </StackPanel>
              <Button Grid.Row="1" Content="曲一覧を更新" HorizontalAlignment="Stretch"
                      IsEnabled="{Binding CanRefreshSongs}" Click="RefreshSongsClick" />
              <ListBox Grid.Row="2" ItemsSource="{Binding Songs}" SelectedItem="{Binding SelectedSong, Mode=TwoWay}"
                       IsEnabled="{Binding CanRefreshSongs}"
                       AutomationProperties.Name="取り込み済みの曲">
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="client:SongListItem">
                    <StackPanel Spacing="2">
                      <TextBlock Text="{Binding Title, TargetNullValue='(読み込めない曲)'}" FontWeight="SemiBold"
                                 TextTrimming="CharacterEllipsis" />
                      <TextBlock Classes="caption" Text="{Binding Artist}"
                                 IsVisible="{Binding Artist, Converter={x:Static ObjectConverters.IsNotNull}}"
                                 TextTrimming="CharacterEllipsis" />
                      <TextBlock Classes="caption" Text="{Binding Error}" Foreground="{DynamicResource OkDanger}"
                                 IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}"
                                 TextWrapping="Wrap" />
                    </StackPanel>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
              <Button Grid.Row="3" Classes="accent" Content="選んだ曲を表示" HorizontalAlignment="Stretch"
                      IsEnabled="{Binding CanLoadSong}" Click="LoadSongClick" />
            </Grid>
          </Border>

          <!-- 歌詞と音程バー -->
          <Border Grid.Column="1" Classes="card">
            <Grid RowDefinitions="Auto,Auto,*,Auto,Auto" RowSpacing="14">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                <StackPanel Spacing="2">
                  <TextBlock Classes="cardTitle" Text="{Binding Karaoke.Title}" TextTrimming="CharacterEllipsis" />
                  <TextBlock Classes="caption" Text="{Binding Karaoke.Artist}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <TextBlock Grid.Column="1" Classes="metric" Text="{Binding Karaoke.PositionText}"
                           VerticalAlignment="Bottom" />
              </Grid>
              <!-- 長い歌詞でも音程バーとスライダーを押し出さないよう、高さを抑えてスクロールさせる -->
              <Border Grid.Row="1" Classes="codeBox" Padding="20,16" MinHeight="96" MaxHeight="150">
                <ScrollViewer>
                  <!-- 中央寄せにすると長い歌詞の先頭へスクロールできなくなるため上寄せにする -->
                  <StackPanel Spacing="6" VerticalAlignment="Top">
                    <TextBlock Classes="lyricCurrent" Text="{Binding Karaoke.CurrentLyric}" TextWrapping="Wrap" />
                    <TextBlock Classes="lyricNext" Text="{Binding Karaoke.NextLyric}" TextWrapping="Wrap" />
                  </StackPanel>
                </ScrollViewer>
              </Border>
              <local:PitchBarView Grid.Row="2" MinHeight="160"
                                  Bars="{Binding Karaoke.Bars}" PlayheadX="{Binding Karaoke.PlayheadX}"
                                  TrackBrush="{DynamicResource OkCodeBackground}"
                                  BarBrush="{DynamicResource OkNeutral}"
                                  ActiveBrush="{DynamicResource SystemControlHighlightAccentBrush}"
                                  PlayheadBrush="{DynamicResource OkForeground}"
                                  AutomationProperties.Name="目標の音程バー" />
              <Slider Grid.Row="3" Minimum="0" Maximum="{Binding Karaoke.DurationSeconds}"
                      Value="{Binding Karaoke.PositionSeconds, Mode=TwoWay}" IsEnabled="{Binding Karaoke.HasSong}"
                      SmallChange="0.1" LargeChange="5" AutomationProperties.Name="表示位置" />
              <TextBlock Grid.Row="4" Classes="caption" TextWrapping="Wrap"
                         Text="歌詞と目標の音程を、指定した位置に合わせて表示します。伴奏の再生・マイクの音程表示・採点はまだありません。" />
            </Grid>
          </Border>
        </Grid>
      </TabItem>

      <TabItem Header="設定">
        <ScrollViewer>
          <StackPanel Spacing="16" Margin="0,12,0,20" MaxWidth="820" HorizontalAlignment="Left">
            <Border Classes="card">
              <StackPanel Spacing="18">
                <StackPanel Spacing="4">
                  <TextBlock Classes="cardTitle" Text="実行環境" />
                  <TextBlock Classes="caption" Text="Coreに接続していない間だけ変更できます。すべて絶対パスで指定します。" />
                </StackPanel>
                <StackPanel Spacing="6" IsEnabled="{Binding CanConnect}">
                  <TextBlock Classes="fieldLabel" Text="Core実行ファイル" />
                  <TextBox Text="{Binding CoreExecutable, Mode=TwoWay}"
                           Watermark="例: C:\OpenKaraoke\open-karaoke-core.exe"
                           AutomationProperties.Name="Core実行ファイルの絶対パス" />
                </StackPanel>
                <StackPanel Spacing="6" IsEnabled="{Binding CanConnect}">
                  <TextBlock Classes="fieldLabel" Text="Python実行ファイル" />
                  <TextBox Text="{Binding PythonExecutable, Mode=TwoWay}"
                           Watermark="空欄なら同梱版または既定のPythonを使います"
                           AutomationProperties.Name="Python実行ファイルの絶対パス" />
                </StackPanel>
                <StackPanel Spacing="6" IsEnabled="{Binding CanConnect}">
                  <TextBlock Classes="fieldLabel" Text="データ保存先" />
                  <TextBox Text="{Binding DataDirectory, Mode=TwoWay}"
                           Watermark="例: D:\OpenKaraoke\data"
                           AutomationProperties.Name="データ保存先の絶対パス" />
                </StackPanel>
              </StackPanel>
            </Border>
            <Border Classes="infoBar">
              <TextBlock Classes="body"
                         Text="設定はこの起動中だけ保持します。開発環境では先にCoreをビルドし、Python解析パッケージをインストールしてください。一般向けのランタイム同梱は未実装です。" />
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
    </TabControl>

    <!-- 下部の注意書き -->
    <Border Grid.Row="3" Padding="24,8,24,14">
      <TextBlock Classes="caption"
                 Text="通信はこの端末内だけで行います。終了時には、この画面から起動したCoreを停止します。" />
    </Border>
  </Grid>
</Window>
