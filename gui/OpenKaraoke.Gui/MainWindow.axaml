<Window
    x:Class="OpenKaraoke.Gui.MainWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Open Karaoke"
    Width="960"
    Height="600">
  <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
    <TextBlock FontSize="32" Text="Open Karaoke" />
    <TextBlock Text="Avalonia GUI bootstrap OK" />
  </StackPanel>
</Window>
